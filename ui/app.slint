export component AppWindow inherits Window {
    title: "Learning By Heart (LBH)";
    preferred-width: 1280px;
    preferred-height: 720px;

    callback mood-voted(int);

    VerticalBox {
        padding: 0px;
        spacing: 0px;

        MenuBar {}

        MoodVotingPanel {
            vertical-stretch: 1;
            mood-voted(id) => {
                root.mood-voted(id);
            }
        }
    }
}
