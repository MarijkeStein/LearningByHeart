export component AppWindow inherits Window {
    title: "Learning By Heart (LBH)";
    preferred-width: 1280px;
    preferred-height: 720px;

    callback mood-voted(int);
    callback start-recording();
    callback stop-recording();

    in-out property <int> current-tab-index: 0;
    in-out property <bool> video-enabled: true;
    in-out property <bool> microphone-enabled: true;
    in-out property <bool> heartbeat-enabled: true;
    in-out property <bool> is-recording: false;

    init => {
        focus-scope.focus();
    }

    focus-scope := FocusScope {
        enabled: true;

        key-pressed(event) => {
            // Ctrl+Tab to switch to next tab (using Key enum)
            if (event.modifiers.control && !event.modifiers.shift && event.text == Key.Tab) {
                root.current-tab-index = mod(root.current-tab-index + 1, 2);
                return accept;
            }
            // Ctrl+Shift+Tab to switch to previous tab
            if (event.modifiers.control && event.modifiers.shift && event.text == Key.Tab) {
                root.current-tab-index = mod(root.current-tab-index - 1 + 2, 2);
                return accept;
            }
            return reject;
        }

        VerticalBox {
            padding: 0px;
            spacing: 0px;

//            MenuBar {}

            TabWidget {
                vertical-stretch: 1;
                current-index: root.current-tab-index;

                Tab {
                    title: "Mood Voting";
                    MoodVotingPanel {
                        mood-voted(id) => {
                            root.mood-voted(id);
                        }
                    }
                }

                Tab {
                    title: "Recording Panel";
                    RecordingPanel {
                        video-enabled <=> root.video-enabled;
                        microphone-enabled <=> root.microphone-enabled;
                        heartbeat-enabled <=> root.heartbeat-enabled;
                        is-recording <=> root.is-recording;
                        start-recording => {
                            root.start-recording();
                        }
                        stop-recording => {
                            root.stop-recording();
                        }
                    }
                }
            }
        }
    }
}
