import { Button, VerticalBox, HorizontalBox } from "std-widgets.slint";

component MenuBar inherits Rectangle {
    background: #2c3e50;
    height: 30px;

    HorizontalBox {
        padding: 5px;
        spacing: 15px;

        Text {
            text: "File";
            color: white;
            vertical-alignment: center;
        }

        Text {
            text: "Edit";
            color: white;
            vertical-alignment: center;
        }

        Text {
            text: "View";
            color: white;
            vertical-alignment: center;
        }

        Text {
            text: "Help";
            color: white;
            vertical-alignment: center;
        }
    }
}

component MoodButton inherits Rectangle {
    in property <string> emoji;
    in property <string> label;
    in property <int> mood-id;
    callback clicked(int);

    property <bool> pressed: false;

    background: pressed ? #3498db : #ffffff;
    border-radius: 12px;
    border-width: 3px;
    border-color: pressed ? #2980b9 : #bdc3c7;

    animate background { duration: 200ms; }
    animate border-color { duration: 200ms; }

    touch-area := TouchArea {
        clicked => {
            root.pressed = true;
            root.clicked(root.mood-id);
            // Reset after animation
            root.pressed = false;
        }
    }

    VerticalBox {
        alignment: center;
        spacing: 8px;

        Text {
            text: root.emoji;
            font-size: 48px;
            font-family: "Noto Color Emoji";
            horizontal-alignment: center;
        }

        Text {
            text: root.label;
            font-size: 16px;
            font-weight: 600;
            color: root.pressed ? #ffffff : #2c3e50;
            horizontal-alignment: center;

            animate color { duration: 200ms; }
        }
    }
}

