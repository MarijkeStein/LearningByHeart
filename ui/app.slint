import { Button, VerticalBox, HorizontalBox, TabWidget, CheckBox, GroupBox } from "std-widgets.slint";

component MoodButton inherits Rectangle {
    in property <string> emoji;
    in property <string> label;
    in property <int> mood-id;
    in property <bool> selected: false;
    callback clicked(int);

    background: selected ? #3498db : #ffffff;
    border-radius: 12px;
    border-width: 3px;
    border-color: selected ? #2980b9 : #bdc3c7;
    drop-shadow-blur: selected ? 4px : 8px;
    drop-shadow-offset-y: selected ? 2px : 4px;
    drop-shadow-color: #00000040;

    animate background { duration: 200ms; }
    animate border-color { duration: 200ms; }
    animate drop-shadow-blur, drop-shadow-offset-y { duration: 200ms; }

    touch-area := TouchArea {
        clicked => {
            root.clicked(root.mood-id);
        }
    }

    VerticalBox {
        alignment: center;
        spacing: 8px;
        padding-top: selected ? 4px : 0px;

        animate padding-top { duration: 200ms; }

        Text {
            text: root.emoji;
            font-size: 48px;
            font-family: "Noto Color Emoji";
            horizontal-alignment: center;
        }

        Text {
            text: root.label;
            font-size: 16px;
            font-weight: 600;
            color: root.selected ? #ffffff : #2c3e50;
            horizontal-alignment: center;

            animate color { duration: 200ms; }
        }
    }
}

component RecordButton inherits Rectangle {
    callback clicked();

    in property <bool> enabled: true;
    in property <bool> is-active: false;
    property <bool> pressed: touch-area.pressed;

    width: 120px;
    height: 120px;
    background: transparent;

    // Button base with shadow
    Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: 12px;
        drop-shadow-blur: (root.is-active || root.pressed) ? 4px : 8px;
        drop-shadow-offset-y: (root.is-active || root.pressed) ? 2px : 4px;
        drop-shadow-color: #00000060;

        background: root.enabled ? ((root.is-active || root.pressed) ? #c0c0c0 : #d8d8d8) : #b8b8b8;

        animate drop-shadow-blur, drop-shadow-offset-y, background { duration: 150ms; }
    }

    touch-area := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    Rectangle {
        width: 60px;
        height: 60px;
        x: (parent.width - self.width) / 2;
        y: (root.is-active || root.pressed) ? (parent.height - self.height) / 2 + 2px : (parent.height - self.height) / 2;
        border-radius: 35px;
        drop-shadow-blur: 6px;
        drop-shadow-offset-y: 2px;
        drop-shadow-color: #00000050;

        background: root.enabled ? (root.is-active ? #ff0000 : #dd0000) : #888888;

        animate y, background { duration: 150ms; }
    }
}

component StopButton inherits Rectangle {
    callback clicked();

    in property <bool> enabled: true;
    in property <bool> is-active: false;
    property <bool> pressed: touch-area.pressed;

    width: 120px;
    height: 120px;
    background: transparent;

    // Button base with shadow
    Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: 12px;
        drop-shadow-blur: (root.is-active || root.pressed) ? 4px : 8px;
        drop-shadow-offset-y: (root.is-active || root.pressed) ? 2px : 4px;
        drop-shadow-color: #00000060;

        background: root.enabled ? ((root.is-active || root.pressed) ? #c0c0c0 : #d8d8d8) : #b8b8b8;

        animate drop-shadow-blur, drop-shadow-offset-y, background { duration: 150ms; }
    }

    touch-area := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    // Black square with shadow and layered lighting
    Rectangle {
        width: 60px;
        height: 60px;
        x: (parent.width - self.width) / 2;
        y: (root.is-active || root.pressed) ? (parent.height - self.height) / 2 + 2px : (parent.height - self.height) / 2;
        border-radius: 6px;
        drop-shadow-blur: 6px;
        drop-shadow-offset-y: 2px;
        drop-shadow-color: #00000050;

        background: root.enabled ? #1a1a1a : #666666;

        animate y { duration: 150ms; }
    }
}

component AudioPreview inherits Rectangle {
    in property <[float]> samples;

    width: 320px;
    height: 180px;
    background: #1a1a1a;
    border-radius: 4px;

    // Draw amplitude bars centered on the midline, spiking both up and down.
    // Squared response curve: quiet noise stays near the flat baseline,
    // only actual speech/sound produces clearly visible spikes.
    for i in min(160, samples.length): Rectangle {
        property <float> normalized: min(1.0, abs(samples[i]) * 3.0);
        property <length> half-height: normalized * normalized * parent.height / 2;

        x: i * 2px;
        y: parent.height / 2 - half-height;
        width: 2px;
        height: max(1px, half-height * 2);
        background: #00ff00;
    }

    // Show "Audio" text when no samples
    if samples.length == 0: Text {
        width: parent.width;
        height: parent.height;
        text: "Audio";
        font-size: 12px;
        color: #666666;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component RecordingPanel inherits Rectangle {
    in-out property <bool> video-enabled: true;
    in-out property <bool> microphone-enabled: true;
    in-out property <bool> heartbeat-enabled: true;
    in-out property <bool> is-recording: false;
    in-out property <image> webcam-preview;
    in-out property <[float]> audio-samples;

    callback start-recording();
    callback stop-recording();

    background: #f5f5f5;

    VerticalBox {
        padding: 30px;
        spacing: 30px;
        alignment: start;

        GroupBox {
            title: "Sensor Configuration";

            GridLayout {
                spacing: 15px;

                Row {
                    HorizontalBox {
                        alignment: start;
                        col: 0;

                        if root.video-enabled: Image {
                            source: root.webcam-preview;
                            width: 320px;
                            height: 180px;
                            image-fit: cover;
                        }
                        if !root.video-enabled: Rectangle {
                            width: 320px;
                            height: 180px;
                            background: black;
                            Text {
                                text: "Camera disabled";
                                color: #555555;
                                font-size: 14px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    HorizontalBox {
                        alignment: start;
                        col: 1;

                        if root.microphone-enabled: AudioPreview {
                            samples: root.audio-samples;
                        }
                        if !root.microphone-enabled: Rectangle {
                            width: 320px;
                            height: 180px;
                            background: black;
                            Text {
                                text: "Microphone disabled";
                                color: #555555;
                                font-size: 14px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    HorizontalBox {
                        alignment: start;
                        col: 2;

                        Rectangle {
                            background: black;
                            width: 320px;
                            height: 180px;
                            Text {
                                text: "Heartbeat not yet supported";
                                color: #555555;
                                font-size: 14px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                Row {
                    HorizontalBox {
                        alignment: start;
                        col: 0;

                        CheckBox {
                            text: "Camera";
                            checked <=> root.video-enabled;
                            enabled: !root.is-recording;
                        }
                    }

                    HorizontalBox {
                        alignment: start;
                        col: 1;

                        CheckBox {
                            text: "Microphone";
                            checked <=> root.microphone-enabled;
                            enabled: !root.is-recording;
                        }
                    }

                    HorizontalBox {
                        alignment: start;
                        col: 2;

                        CheckBox {
                            text: "Heartbeat Sensor";
                            checked <=> root.heartbeat-enabled;
                            enabled: false;
                        }
                    }
                }
            }
        }

        GroupBox {
            title: "Recording Controls";

            HorizontalBox {
                alignment: center;
                spacing: 30px;
                padding: 20px;

                RecordButton {
                    enabled: !root.is-recording;
                    is-active: root.is-recording;
                    clicked => {
                        root.start-recording();
                    }
                }

                StopButton {
                    enabled: root.is-recording;
                    is-active: false;
                    clicked => {
                        root.stop-recording();
                    }
                }
            }
        }

        if root.is-recording : Rectangle {
            height: 60px;
            background: #ffebee;
            border-radius: 8px;
            border-width: 2px;
            border-color: #e53935;

            HorizontalBox {
                padding: 15px;
                spacing: 10px;
                alignment: center;

                Rectangle {
                    width: 12px;
                    height: 12px;
                    border-radius: 6px;
                    background: #e53935;

                    animate background { duration: 500ms; easing: ease-in-out; iteration-count: -1; }
                }

                Text {
                    text: "Recording in progress...";
                    font-size: 18px;
                    font-weight: 600;
                    color: #c62828;
                }
            }
        }
    }
}

