component MoodButton inherits Rectangle {
    in property <string> emoji;
    in property <string> label;
    in property <int> mood-id;
    in property <bool> selected: false;
    callback clicked(int);

    background: selected ? #3498db : #ffffff;
    border-radius: 12px;
    border-width: 3px;
    border-color: selected ? #2980b9 : #bdc3c7;
    drop-shadow-blur: selected ? 4px : 8px;
    drop-shadow-offset-y: selected ? 2px : 4px;
    drop-shadow-color: #00000040;

    animate background { duration: 200ms; }
    animate border-color { duration: 200ms; }
    animate drop-shadow-blur, drop-shadow-offset-y { duration: 200ms; }

    touch-area := TouchArea {
        clicked => {
            root.clicked(root.mood-id);
        }
    }

    VerticalBox {
        alignment: center;
        spacing: 8px;
        padding-top: selected ? 4px : 0px;

        animate padding-top { duration: 200ms; }

        Text {
            text: root.emoji;
            font-size: 48px;
            font-family: "Noto Color Emoji";
            horizontal-alignment: center;
        }

        Text {
            text: root.label;
            font-size: 16px;
            font-weight: 600;
            color: root.selected ? #ffffff : #2c3e50;
            horizontal-alignment: center;

            animate color { duration: 200ms; }
        }
    }
}

component RecordButton inherits Rectangle {
    callback clicked();

    in property <bool> enabled: true;
    in property <bool> is-active: false;
    property <bool> pressed: touch-area.pressed;

    width: 120px;
    height: 120px;
    background: transparent;

    // Button base with shadow
    Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: 12px;
        drop-shadow-blur: (root.is-active || root.pressed) ? 4px : 8px;
        drop-shadow-offset-y: (root.is-active || root.pressed) ? 2px : 4px;
        drop-shadow-color: #00000060;

        background: root.enabled ? ((root.is-active || root.pressed) ? #c0c0c0 : #d8d8d8) : #b8b8b8;

        animate drop-shadow-blur, drop-shadow-offset-y, background { duration: 150ms; }

//        // Top gradient layer for 3D effect
//        Rectangle {
//            width: parent.width;
//            height: parent.height / 2;
//            border-radius: 12px;
//            background: #ffffff30;
//        }
    }

    touch-area := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    // Red circle with shadow and layered lighting
    Rectangle {
        width: 60px;
        height: 60px;
        x: (parent.width - self.width) / 2;
        y: (root.is-active || root.pressed) ? (parent.height - self.height) / 2 + 2px : (parent.height - self.height) / 2;
        border-radius: 35px;
        drop-shadow-blur: 6px;
        drop-shadow-offset-y: 2px;
        drop-shadow-color: #00000050;

        background: root.enabled ? (root.is-active ? #ff0000 : #dd0000) : #888888;

        animate y, background { duration: 150ms; }

//        // Top highlight for spherical appearance
//        Rectangle {
//            width: parent.width;
//            height: parent.height / 2.5;
//            y: 5px;
//            border-radius: 35px;
//            background: #ff4444;
//        }
//
//        // Glossy highlight
//        Rectangle {
//            width: 25px;
//            height: 25px;
//            x: 12px;
//            y: 10px;
//            border-radius: 15px;
//            background: #ffffff80;
//        }
//
//        // Bottom shadow for depth
//        Rectangle {
//            width: parent.width - 10px;
//            height: 15px;
//            x: 5px;
//            y: parent.height - 18px;
//            border-radius: 20px;
//            background: #00000030;
//        }
    }
}

