component RecordingPanel inherits Rectangle {
    in-out property <bool> video-enabled: true;
    in-out property <bool> microphone-enabled: true;
    in-out property <bool> heartbeat-enabled: true;
    in-out property <bool> is-recording: false;

    callback start-recording();
    callback stop-recording();

    background: #f5f5f5;

    VerticalBox {
        padding: 30px;
        spacing: 30px;
        alignment: start;

        Text {
            text: "Recording Panel";
            font-size: 24px;
            font-weight: 700;
            color: #2c3e50;
        }

        GroupBox {
            title: "Sensor Configuration";

            VerticalBox {
                spacing: 15px;
                padding: 10px;

                CheckBox {
                    text: "Video Stream";
                    checked <=> root.video-enabled;
                    enabled: !root.is-recording;
                }

                CheckBox {
                    text: "Microphone";
                    checked <=> root.microphone-enabled;
                    enabled: !root.is-recording;
                }

                CheckBox {
                    text: "Heartbeat Sensor (RRI)";
                    checked <=> root.heartbeat-enabled;
                    enabled: !root.is-recording;
                }
            }
        }

        GroupBox {
            title: "Recording Controls";

            HorizontalBox {
                alignment: center;
                spacing: 30px;
                padding: 20px;

                RecordButton {
                    enabled: !root.is-recording;
                    is-active: root.is-recording;
                    clicked => {
                        root.start-recording();
                    }
                }

                StopButton {
                    enabled: root.is-recording;
                    is-active: false;
                    clicked => {
                        root.stop-recording();
                    }
                }
            }
        }

        if root.is-recording : Rectangle {
            height: 60px;
            background: #ffebee;
            border-radius: 8px;
            border-width: 2px;
            border-color: #e53935;

            HorizontalBox {
                padding: 15px;
                spacing: 10px;
                alignment: center;

                Rectangle {
                    width: 12px;
                    height: 12px;
                    border-radius: 6px;
                    background: #e53935;

                    animate background { duration: 500ms; easing: ease-in-out; iteration-count: -1; }
                }

                Text {
                    text: "Recording in progress...";
                    font-size: 18px;
                    font-weight: 600;
                    color: #c62828;
                }
            }
        }
    }
}

